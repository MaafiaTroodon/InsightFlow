generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dataset {
  id                   String        @id @default(cuid())
  userId               String?
  name                 String
  originalFileName     String
  fileType             String?
  rawRowCount          Int?
  rowCount             Int
  duplicateRowsRemoved Int           @default(0)
  missingValuesFixed   Int           @default(0)
  columnMapping        Json?
  warnings             Json?
  createdAt            DateTime      @default(now())
  user                 User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows                 BusinessRow[]

  @@index([userId])
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  createdAt            DateTime              @default(now())
  datasets             Dataset[]
  constructionProjects ConstructionProject[]
  projectTrades        ProjectTrade[]
}

model ConstructionProject {
  id              String         @id @default(cuid())
  userId          String
  name            String
  clientName      String?
  address         String?
  type            String?
  status          String         @default("Active")
  budget          Decimal?       @db.Decimal(18, 2)
  contractValue   Decimal?       @db.Decimal(18, 2)
  startDate       DateTime?
  endDate         DateTime?
  percentComplete Int            @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteLogs        DailySiteLog[]
  rfis            RFI[]
  deficiencies    Deficiency[]
  safetyRecords   SafetyRecord[]
  submittals      Submittal[]
  scheduleItems   ScheduleItem[]
  trades          ProjectTrade[]

  @@index([userId])
}

model DailySiteLog {
  id          String              @id @default(cuid())
  projectId   String
  date        DateTime
  weather     String?
  temperature String?
  workers     Int?
  notes       String?
  createdBy   String?
  createdAt   DateTime            @default(now())
  project     ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RFI {
  id          String              @id @default(cuid())
  projectId   String
  number      String
  subject     String
  description String?
  status      String              @default("Open")
  ballInCourt String?
  submittedBy String?
  assignedTo  String?
  dueDate     DateTime?
  answeredAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Deficiency {
  id          String              @id @default(cuid())
  projectId   String
  number      String
  description String
  location    String?
  trade       String?
  assignedTo  String?
  status      String              @default("Open")
  priority    String              @default("Medium")
  dueDate     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SafetyRecord {
  id          String              @id @default(cuid())
  projectId   String
  type        String
  title       String
  description String?
  date        DateTime
  recordedBy  String?
  status      String?
  createdAt   DateTime            @default(now())
  project     ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Submittal {
  id          String              @id @default(cuid())
  projectId   String
  number      String
  title       String
  trade       String?
  type        String?
  status      String              @default("Pending")
  submittedBy String?
  reviewedBy  String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ScheduleItem {
  id              String              @id @default(cuid())
  projectId       String
  name            String
  type            String              @default("Baseline")
  phase           String?
  startDate       DateTime
  endDate         DateTime
  percentComplete Int                 @default(0)
  predecessor     String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTrade {
  id            String              @id @default(cuid())
  projectId     String
  userId        String
  companyName   String
  contactName   String?
  email         String?
  phone         String?
  trade         String
  contractValue Decimal?            @db.Decimal(18, 2)
  status        String              @default("Active")
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BusinessRow {
  id           String   @id @default(cuid())
  datasetId    String
  projectName  String
  clientName   String?
  status       String?
  date         DateTime?
  revenue      Decimal  @db.Decimal(18, 2)
  cost         Decimal  @db.Decimal(18, 2)
  budget       Decimal? @db.Decimal(18, 2)
  profit       Decimal  @db.Decimal(18, 2)
  margin       Decimal  @db.Decimal(7, 4)
  isOverBudget Boolean  @default(false)
  rawJson      Json
  createdAt    DateTime @default(now())
  dataset      Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}
